# Pub lock
# For an app (like APK Organizer) keep pubspec.lock committed for reproducible builds.
# Uncomment below only for libraries/packages:
# pubspec.lock
# **/pubspec.lock

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android - build outputs (handled by /build/ but keep explicit for safety)
# /android/app/debug, /android/app/profile, /android/app/release are ignored via root /build/ and android/.gitignore
/android/app/debug
/android/app/profile
/android/app/release

# Android - Gradle & local config (see android/.gitignore for gradle-wrapper.jar, .gradle, etc.)
